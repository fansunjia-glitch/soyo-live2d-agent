DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=

# Required for every chat/session/TTS/ASR request, including localhost.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENT_ACCESS_TOKEN=

LLM_MODEL=qwen3.6-flash
LLM_ALLOWED_MODELS=qwen3.6-flash
ASR_MODEL=paraformer-realtime-v2
ASR_ALLOWED_MODELS=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v3.5-flash
TTS_ALLOWED_MODELS=cosyvoice-v3.5-flash
TTS_VOICE=longxiaochun
TTS_VOICE_SOYO_SOFT=
TTS_VOICE_SOYO_NATURAL=

PORT=8787
LIVE2D_MODEL_PATH=/models/soyo/bestdori/model.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only list reverse-proxy peer IPs that overwrite/sanitize X-Forwarded-For.
TRUSTED_PROXY_HOSTS=
CONVERSATION_STORE_PATH=backend/data/conversations.json

# Enables the personal iPhone agent control plane. This is separate from the
# conversation access token and must also remain server-side only.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEVICE_CONTROL_ADMIN_TOKEN=
# Paired device credentials expire after this many seconds (default: 30 days).
DEVICE_SESSION_TTL_SECONDS=2592000
DEVICE_STORE_PATH=backend/data/devices.sqlite3

# Frontend-only variables. Leave empty for local Vite proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# Required unless the matching trusted runtime is preloaded by your host page.
# Only the runtime matching the model format is loaded. Prefer same-origin,
# licensed, version-pinned files; remote mutable scripts share your app origin.
VITE_CUBISM2_RUNTIME_URL=/vendor/live2d/cubism2/live2d.min.js
VITE_CUBISM4_RUNTIME_URL=/vendor/live2d/cubism4/live2dcubismcore.min.js

# Optional. Required only when cloning from --audio-file instead of --audio-url.
PUBLIC_BASE_URL=https://your-deployed-domain.example
